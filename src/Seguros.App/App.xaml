<Application x:Class="Seguros.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Seguros.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta de colores -->
            <SolidColorBrush x:Key="ColorFondo" Color="#F4F6F8"/>
            <SolidColorBrush x:Key="ColorSuperficie" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ColorBorde" Color="#D5DAE0"/>
            <SolidColorBrush x:Key="ColorTextoPrincipal" Color="#1F2933"/>
            <SolidColorBrush x:Key="ColorTextoSecundario" Color="#5A6672"/>
            <SolidColorBrush x:Key="ColorPrimario" Color="#2C5F8A"/>
            <SolidColorBrush x:Key="ColorPrimarioHover" Color="#244C6F"/>
            <SolidColorBrush x:Key="ColorPrimarioPresionado" Color="#1C3C58"/>
            <SolidColorBrush x:Key="ColorPeligro" Color="#B3402A"/>
            <SolidColorBrush x:Key="ColorPeligroHover" Color="#8F3320"/>
            <SolidColorBrush x:Key="ColorExito" Color="#2E7D4F"/>
            <SolidColorBrush x:Key="ColorAlerta" Color="#B36B00"/>
            <SolidColorBrush x:Key="ColorEncabezadoGrilla" Color="#E7EBEF"/>
            <SolidColorBrush x:Key="ColorFilaAlterna" Color="#F7F9FA"/>
            <SolidColorBrush x:Key="ColorSeleccion" Color="#D6E6F2"/>

            <!-- Tipografía base -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            </Style>

            <Style TargetType="{x:Type UserControl}">
                <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
            </Style>

            <!-- Botones -->
            <Style x:Key="BotonBase" TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorPrimarioHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorPrimarioPresionado}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BotonBase}"/>

            <Style x:Key="BotonPeligro" TargetType="{x:Type Button}" BasedOn="{StaticResource BotonBase}">
                <Setter Property="Background" Value="{StaticResource ColorPeligro}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorPeligroHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BotonSecundario" TargetType="{x:Type Button}" BasedOn="{StaticResource BotonBase}">
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Campos de entrada -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="{x:Type DatePicker}">
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
            </Style>

            <!-- Texto de sección / etiquetas -->
            <Style x:Key="Etiqueta" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <Style x:Key="TituloSeccion" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- GroupBox -->
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupBox}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource ColorEncabezadoGrilla}"
                                        CornerRadius="4,4,0,0" Padding="10,6">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"
                                                       TextElement.Foreground="{StaticResource ColorPrimario}"/>
                                </Border>
                                <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,4,4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid -->
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource ColorFilaAlterna}"/>
                <Setter Property="RowBackground" Value="{StaticResource ColorSuperficie}"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{StaticResource ColorEncabezadoGrilla}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorSeleccion}"/>
                        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Pestañas -->
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
