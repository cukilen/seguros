<UserControl x:Class="Seguros.App.Vistas.VencimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Ventana (días):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtDias" Width="50" Text="30" Margin="0,0,12,0"/>
            <TextBlock Text="Compañía:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbCompania" Width="150" DisplayMemberPath="Nombre" Margin="0,0,12,0"/>
            <Button Content="Ver próximas a vencer" Click="BtnProximas_Click" Margin="0,0,8,0"/>
            <Button Content="Ver vencidas" Click="BtnVencidas_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Asegurado" Binding="{Binding Asegurado.Nombre}" Width="160"/>
                <DataGridTextColumn Header="Compañía" Binding="{Binding Compania.Nombre}" Width="140"/>
                <DataGridTextColumn Header="Ramo" Binding="{Binding Ramo.Nombre}" Width="120"/>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="90"/>
                <DataGridTextColumn Header="Vence" Binding="{Binding VigenciaHasta}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Marcar como gestionado" Click="BtnMarcarGestionado_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
