<UserControl x:Class="Seguros.App.Vistas.EndososView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Póliza:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbPoliza" Width="280" DisplayMemberPath="Numero" SelectionChanged="CmbPoliza_SelectionChanged" Margin="0,0,12,0"/>
            <Button Content="Actualizar listado de pólizas" Click="BtnActualizarPolizas_Click"/>
        </StackPanel>

        <GroupBox Header="Nuevo endoso" Grid.Row="1" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="DpFecha" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtTipo" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Detalle" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtDetalle" Width="260"/>
                </StackPanel>
                <Button Content="Agregar endoso" VerticalAlignment="Bottom" Click="BtnAgregar_Click"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="100"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="150"/>
                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="300"/>
                <DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Anulado, Mode=OneWay}" IsReadOnly="True" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Anular endoso seleccionado" Grid.Row="3" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Motivo de anulación" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtMotivoAnulacion" Width="220"/>
                </StackPanel>
                <Button Content="Anular endoso" Style="{StaticResource BotonPeligro}" VerticalAlignment="Bottom" Click="BtnAnular_Click"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
