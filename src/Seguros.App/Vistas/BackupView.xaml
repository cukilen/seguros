<UserControl x:Class="Seguros.App.Vistas.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16" HorizontalAlignment="Left">
        <TextBlock TextWrapping="Wrap" MaxWidth="500" Margin="0,0,0,12">
            Genera una copia del archivo de base de datos local. Guardala en una carpeta
            segura (por ejemplo un pendrive o una carpeta en la nube) para poder
            restaurarla si algo le pasa a esta PC.
        </TextBlock>
        <Button Content="Hacer backup ahora..." HorizontalAlignment="Left" Padding="8,4" Click="BtnBackup_Click"/>
        <TextBlock x:Name="TxtResultado" Margin="0,12,0,0" Foreground="Green"/>
    </StackPanel>
</UserControl>
