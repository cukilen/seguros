<UserControl x:Class="Seguros.App.Vistas.PolizasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Nueva póliza" Grid.Row="0" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Asegurado" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CmbAsegurado" Width="160" DisplayMemberPath="Nombre"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Compañía" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CmbCompania" Width="140" DisplayMemberPath="Nombre"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ramo" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CmbRamo" Width="150" DisplayMemberPath="Nombre"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Número" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNumero" Width="90"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="DpDesde" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="DpHasta" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Prima" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPrima" Width="80"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0" VerticalAlignment="Bottom">
                    <CheckBox x:Name="ChkFlota" Content="Es flota" Margin="0,0,0,7"/>
                </StackPanel>
                <Button Content="Agregar" VerticalAlignment="Bottom" Padding="14,7" Click="BtnAgregar_Click"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filtrar por ramo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbFiltroRamo" Width="150" DisplayMemberPath="Nombre" SelectionChanged="Filtro_Changed" Margin="0,0,12,0"/>
            <TextBlock Text="Filtrar por compañía:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbFiltroCompania" Width="150" DisplayMemberPath="Nombre" SelectionChanged="Filtro_Changed" Margin="0,0,12,0"/>
            <Button Content="Limpiar filtros" Style="{StaticResource BotonSecundario}" Click="BtnLimpiarFiltros_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Asegurado" Binding="{Binding Asegurado.Nombre}" Width="150"/>
                <DataGridTextColumn Header="Compañía" Binding="{Binding Compania.Nombre}" Width="130"/>
                <DataGridTextColumn Header="Ramo" Binding="{Binding Ramo}" Width="120"/>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="90"/>
                <DataGridTextColumn Header="Desde" Binding="{Binding VigenciaDesde}" Width="100"/>
                <DataGridTextColumn Header="Hasta" Binding="{Binding VigenciaHasta}" Width="100"/>
                <DataGridTextColumn Header="Prima" Binding="{Binding Prima}" Width="80"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Header="Acciones sobre la póliza seleccionada" Grid.Row="4" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Motivo de anulación" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtMotivoAnulacion" Width="180"/>
                </StackPanel>
                <Button Content="Anular" Style="{StaticResource BotonPeligro}" VerticalAlignment="Bottom" Margin="0,0,24,0" Click="BtnAnular_Click"/>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nuevo número" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNuevoNumero" Width="100"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nueva vigencia hasta" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="DpNuevaVigenciaHasta" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nueva prima" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNuevaPrima" Width="80"/>
                </StackPanel>
                <Button Content="Renovar" VerticalAlignment="Bottom" Click="BtnRenovar_Click"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
