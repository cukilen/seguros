<UserControl x:Class="Seguros.App.Vistas.CompaniasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Nueva compañía" Grid.Row="0" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Nombre"/>
                    <TextBox x:Name="TxtNombre" Width="180"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Teléfono"/>
                    <TextBox x:Name="TxtTelefono" Width="130"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Email"/>
                    <TextBox x:Name="TxtEmail" Width="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Ramos que opera"/>
                    <ListBox x:Name="LstRamos" SelectionMode="Multiple" Height="80" Width="160"/>
                </StackPanel>
                <Button Content="Agregar" VerticalAlignment="Bottom" Height="26" Click="BtnAgregar_Click"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Ramos" Binding="{Binding RamosTexto}" Width="260"/>
                <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activa}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Inactivar seleccionada" Click="BtnInactivar_Click" Margin="0,0,8,0"/>
            <Button Content="Eliminar seleccionada" Click="BtnEliminar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
