<Window x:Class="Seguros.App.Vistas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Seguros - Ingreso" Height="320" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión Integral de Seguros" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel x:Name="PanelNombre" Grid.Row="1" Orientation="Vertical" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Nombre del productor"/>
            <TextBox x:Name="TxtNombre"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Usuario"/>
            <TextBox x:Name="TxtUsuario"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Contraseña"/>
            <PasswordBox x:Name="TxtPassword"/>
        </StackPanel>

        <TextBlock x:Name="TxtError" Grid.Row="4" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button x:Name="BtnAccionPrincipal" Content="Ingresar" Width="90" Click="BtnAccionPrincipal_Click"/>
        </StackPanel>

        <Button x:Name="BtnAlternar" Grid.Row="7" Content="¿Primera vez? Crear productor" HorizontalAlignment="Left"
                Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand"
                Click="BtnAlternar_Click"/>
    </Grid>
</Window>
